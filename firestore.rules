rules_version = '2';

// QA Radar — "סנכרון בין מכשירים" (see README → "Sync between devices").
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
//
// Each item of "שלי" is one document: users/{uid}/items/{key} = { k: key, v: JSON text or null, t: ISO date }.
// An account can read and write only its own items, and only in that shape. Deleted items are
// kept as `v: null` (so an offline device can't bring them back), so nothing is ever deleted.
//
// The site is public, so anyone could sign in with their own Google account. OWNER_UID limits the
// database to your account alone: after your first sign-in, copy your User UID from
// Authentication → Users and put it here (it is an opaque id, not personal data).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid && uid == 'OWNER_UID';
    }

    match /users/{uid}/items/{item} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['k', 'v', 't'])
        && request.resource.data.k is string
        && request.resource.data.t is string
        && (request.resource.data.v == null
          || (request.resource.data.v is string && request.resource.data.v.size() < 200000));
    }
  }
}
