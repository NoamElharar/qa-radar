# "סנכרון בין מכשירים" — the Firebase web app's settings
# (Firebase console → Project settings → General → Your apps → SDK setup and configuration → Config).
# They are public by design: access is controlled by Google sign-in and ../firestore.rules.
# Leave them empty to build without sync (the card in "שלי" then doesn't appear).
#
# Local development: copy this file to web/.env.local (git-ignored) and fill it in.
# The deployed site gets them from the repository's Actions variables (FIREBASE_*), see collect.yml.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
